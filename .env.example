# PAM AI — environment variable template
# Copy to .env.local for local dev:  cp .env.example .env.local
# .env.local is gitignored — NEVER commit real secrets.
#
# You do NOT need most of these to build. See the tiers below.
# Full explanation: COLLABORATION.md


# ── TIER 0 — build the UI with NOTHING ───────────────────────────────────────
# Run `node server.js`, open http://127.0.0.1:3000, enter demo code PAMDEVTEAM,
# and use the dev-preview trick in COLLABORATION.md to see the full dashboard
# with sample data. No secrets required for most front-end work.

PAM_SITE_URL=http://127.0.0.1:3000
DEMO_ACCESS_CODE=PAMDEVTEAM


# ── TIER 1 — add ONE key to get real AI answers locally ──────────────────────
# Without this, /api/decision still works but falls back to deterministic
# guidance (no AI prose). PAM uses Anthropic Claude — NOT OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5


# ── TIER 2 — only fill these if you're working on that feature ───────────────

# Auth (Clerk) — sign-in / sign-up
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database (Supabase / Postgres)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bank data (Plaid) — keep PLAID_ENV=sandbox until production is approved
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,balance,liabilities
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=
PAM_PLAID_TOKEN_SECRET=

# Email (Resend) — verification codes + waitlist
RESEND_API_KEY=
PAM_FROM_EMAIL=PAM AI <hello@pamadvisor.com>
RESEND_AUDIENCE_ID=
WAITLIST_NOTIFY_EMAIL=

# Analytics (PostHog) + errors (Sentry)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# Payments (Stripe) — currently OFF; only needed when the subscription gate flips on
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_FOUNDING=
STRIPE_WEBHOOK_SECRET=

# Admin / security
PAM_ADMIN_SECRET=
SESSION_SECRET=


# ── Service kill switches (set to true to disable an integration) ────────────
PAM_DISABLE_AI=false
PAM_DISABLE_PLAID=false
PAM_DISABLE_EMAIL=false


# ── Cost-protection daily limits (sane defaults; usually leave as-is) ─────────
PAM_AI_IP_DAILY_LIMIT=80
PAM_AI_USER_DAILY_LIMIT=30
PAM_PLAID_IP_DAILY_LIMIT=80
PAM_PLAID_USER_DAILY_LIMIT=30
PAM_EMAIL_IP_DAILY_LIMIT=25
PAM_EMAIL_USER_DAILY_LIMIT=5
PAM_TELEMETRY_IP_DAILY_LIMIT=500
PAM_TELEMETRY_USER_DAILY_LIMIT=250
